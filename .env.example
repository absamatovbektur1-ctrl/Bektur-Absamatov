# Скопируй этот файл в .env и впиши свои значения. .env никогда не коммить.

# HikerAPI (radar): hikerapi.com -> личный кабинет -> Access Key
HIKER_API_KEY=your_hikerapi_key

# Metricool (publisher + tracker): metricool.com -> настройки -> API
METRICOOL_USER_ID=your_user_id
METRICOOL_BLOG_ID=your_blog_id
METRICOOL_API_TOKEN=your_api_token

# Часовой пояс для публикаций (аудитория в Кыргызстане)
TIMEZONE=Asia/Bishkek
